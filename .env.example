# === Database ===
DATABASE_URL=postgresql+asyncpg://dotsound:dotsound@localhost:5432/dotsound

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === MinIO (S3) ===
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=dotsound-audio
MINIO_USE_SSL=false

# === Application ===
LOG_LEVEL=INFO
DEBUG=true
REDACT_LOGS=true
COMPLAINT_THRESHOLD=3

# === SoundCloud (optional) ===
SC_CLIENT_ID=

# === Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# === Auth ===
JWT_SECRET=changeme-set-a-strong-secret-in-production
JWT_EXPIRE_DAYS=7

# === Email Auth (Resend) ===
# API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx
# Sender address (must be verified in Resend dashboard)
RESEND_FROM_EMAIL=noreply@yourdomain.com
# Magic link expiry in minutes
MAGIC_LINK_TTL_MINUTES=15

# === 2FA / TOTP ===
# 32-byte key, base64-encoded for encrypting TOTP secrets in DB
# Generate: python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
TOTP_ENCRYPTION_KEY=

# === Chat Encryption ===
# 32-byte key, base64-encoded. Generate: python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
CHAT_ENCRYPTION_KEY=

# === Upload Security ===
# Режим сканирования загрузок: none | lightweight | clamav
# none      — без сканирования (magic bytes + Pillow re-encode всё ещё работают)
# lightweight — эвристики + YARA (рекомендуется для VPS 1-2 ядра / 2-4 GB RAM)
# clamav    — полный AV через clamd (рекомендуется для VPS 4+ ядер / 4+ GB RAM)
UPLOAD_MALWARE_SCAN_MODE=none

# === Media Processing ===
IMAGE_CHAT_MAX_SIZE=1280
IMAGE_AVATAR_MAX_SIZE=400
IMAGE_COVER_MAX_SIZE=800
IMAGE_QUALITY=80
IMAGE_THUMBNAIL_SIZE=320
IMAGE_STRIP_METADATA=true
VOICE_BITRATE=64k
VOICE_MAX_DURATION=300

# === WebSocket ===
WS_HEARTBEAT_INTERVAL=30

# === CORS ===
# Разрешённые домены для запросов к API (через запятую).
# Для разработки: *
# Для продакшна: https://your-domain.com
ALLOWED_ORIGINS=*

# === Admin Panel ===
# Отдельный секрет для admin JWT (scope=admin). Если пусто —
# fallback на JWT_SECRET; в production обязательно отдельный.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
ADMIN_JWT_SECRET=
# Секрет для CSRF double-submit cookie. Generate: token_urlsafe(32)
ADMIN_CSRF_SECRET=
# chat_id Telegram для критичных алертов (через DotSoundBot).
ADMIN_TELEGRAM_ALERT_CHAT_ID=
# TTL подписанной HMAC-ссылки на admin-bundle.js (секунды).
ADMIN_BUNDLE_TTL_SECONDS=3600

# === Observability (опционально) ===
# Если URL пуст — соответствующий компонент не подключается.
PROMETHEUS_URL=
LOKI_URL=
TEMPO_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=

SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Путь к Docker socket для container health check.
# По умолчанию /var/run/docker.sock на Linux.
# На Windows для разработки можно оставить пустым — health-check
# вернёт пустой список без ошибок.
DOCKER_SOCKET_PATH=/var/run/docker.sock

# === Bot Internal API ===
# URL and shared secret for backend <-> bot communication (import features).
BOT_INTERNAL_URL=http://localhost:8081
BOT_INTERNAL_SECRET=change-me-shared-secret

# === Mini App URL ===
# URL Mini App для кнопок в боте.
# Для разработки через ngrok: https://<id>.ngrok-free.app/mini_app/
# Для продакшна: https://your-domain.com/mini_app/
MINI_APP_URL=

# === Outbound HTTP identity ===
# User-Agent для исходящих запросов к публичным источникам
# (Wikipedia/Wikimedia и т. п.). Wikimedia блокирует запросы без
# осмысленного UA -> 403.
#
# Требования Wikimedia (https://meta.wikimedia.org/wiki/User-Agent_policy):
#   1) уникальное имя клиента + версия
#   2) рабочий способ связи (mailto: или https-URL)
# Имя проекта/бренд раскрывать НЕ обязательно. Главное — чтобы
# админ Wikimedia мог с тобой связаться при проблемах, а не
# банить вслепую всю подсеть.
#
# Формат: <name>/<version> (+mailto:contact@your-domain)
# или:    <name>/<version> (+https://your-domain/contact)
#
# Дефолт ниже использует example.invalid — он работает для
# единичных запросов, но при заметном трафике замени на свой
# рабочий email/домен, иначе рискуешь баном без предупреждения.
OUTBOUND_USER_AGENT=metadata-fetcher/1.0 (+mailto:webmaster@example.invalid)
# Опционально: HTTP From-заголовок. Пусто = не отправляем.
OUTBOUND_CONTACT_EMAIL=

# === Backup ===
# GPG passphrase для шифрования дампов БД.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=3
# Удалённый сервер для rsync (пусто = только локальные бэкапы).
BACKUP_REMOTE_HOST=
BACKUP_REMOTE_PATH=/backups/dotsound
BACKUP_REMOTE_SSH_KEY=
