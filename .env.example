# === Database ===
DATABASE_URL=postgresql+asyncpg://dotsound:dotsound@localhost:5432/dotsound

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === Elasticsearch (suggest + full text search) ===
# Default in app/config.py is http://127.0.0.1:9200 — set explicitly when
# different, or set ELASTICSEARCH_URL= to disable. In Docker: http://elasticsearch:9200
# Local (host): `docker compose up -d elasticsearch` and use 127.0.0.1:9200
ELASTICSEARCH_URL=http://127.0.0.1:9200
# Set to false to disable all ES usage and use PostgreSQL ILIKE only
ELASTICSEARCH_ENABLED=true
# If ES search returns 0 results, also query PostgreSQL (avoids empty UI when
# the index is empty or behind). Set false to enforce ES-only results
ELASTICSEARCH_FALLBACK_TO_POSTGRES_ON_ZERO=true
ELASTICSEARCH_INDEX_TRACKS=dotsound_tracks
ELASTICSEARCH_INDEX_ARTISTS=dotsound_artists
# One-time: enqueue full reindex if track index has zero documents (dev)
ELASTICSEARCH_BACKFILL_ON_EMPTY=false
# Play count -> ES: batch flush interval (seconds) for dirty ids
ELASTICSEARCH_PLAYCOUNT_FLUSH_INTERVAL_SECONDS=90
# Development: create indices + wait for cluster; optional backfill
ELASTICSEARCH_DEV_BOOTSTRAP=false
# Fuzzy layer for track/artist search and suggest (Levenshtein; AUTO = ES heuristics)
ELASTICSEARCH_TRACK_FUZZINESS=AUTO
# Cap term expansions for fuzzy token matching (lower = less load, fewer near-matches)
ELASTICSEARCH_FUZZY_MAX_EXPANSIONS=50

# === MinIO (S3) ===
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=dotsound-audio
MINIO_USE_SSL=false

# === Application ===
LOG_LEVEL=INFO
# ``LOG_THIRD_PARTY_LEVEL`` caps *stdlib* loggers only (not structlog
# event names). See ``THIRD_PARTY_LOGGER_NAMES`` in
# ``app/core/logging.py`` (includes ``elastic_transport.*``, urllib3,
# httpx, …). Applied in ``configure_logging`` (API) and on import of
# ``app.core.tkq`` (Taskiq workers). After changing, restart **both** the
# API and all ``taskiq worker`` processes. WARNING = hide INFO; ERROR =
# extra quiet; DEBUG = full client trace.
LOG_THIRD_PARTY_LEVEL=WARNING
DEBUG=true
REDACT_LOGS=true
# With REDACT_LOGS=true, set REDACT_LOG_IDENTIFIERS=false to show
# correlation ids (user_id, file_id, client_ip, …) in structlog; leave
# true in shared or production log sinks.
REDACT_LOG_IDENTIFIERS=true
COMPLAINT_THRESHOLD=3
# Radio queue (Sprint 1) — use RADIO_ENABLED=false to serve catalog only
RADIO_ENABLED=true
RADIO_YOUTUBE_MIX_ENABLED=true
RADIO_MAX_SUGGESTIONS=10
# Snippet jobs (Sprint 5) — set SNIPPET_EXTERNAL_CATALOG_ALLOWED=true only after
# product + legal sign-off (third-party / external_reference)
SNIPPET_FFMPEG_ENABLED=true
SNIPPET_EXTERNAL_CATALOG_ALLOWED=false

# === SoundCloud (optional) ===
SC_CLIENT_ID=

# === Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# === Auth ===
JWT_SECRET=changeme-set-a-strong-secret-in-production
JWT_EXPIRE_DAYS=7

# === Email Auth (Resend) ===
# API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx
# Sender address (must be verified in Resend dashboard)
RESEND_FROM_EMAIL=noreply@yourdomain.com
# Magic link expiry in minutes
MAGIC_LINK_TTL_MINUTES=15

# === 2FA / TOTP ===
# 32-byte key, base64-encoded for encrypting TOTP secrets in DB
# Generate: python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
TOTP_ENCRYPTION_KEY=

# === Chat Encryption ===
# 32-byte key, base64-encoded. Generate: python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
CHAT_ENCRYPTION_KEY=

# === Upload Security ===
# Режим сканирования загрузок: none | lightweight | clamav
# none      — без сканирования (magic bytes + Pillow re-encode всё ещё работают)
# lightweight — эвристики + YARA (рекомендуется для VPS 1-2 ядра / 2-4 GB RAM)
# clamav    — полный AV через clamd (рекомендуется для VPS 4+ ядер / 4+ GB RAM)
UPLOAD_MALWARE_SCAN_MODE=none

# === Media Processing ===
IMAGE_CHAT_MAX_SIZE=1280
IMAGE_AVATAR_MAX_SIZE=400
IMAGE_COVER_MAX_SIZE=800
IMAGE_QUALITY=80
IMAGE_THUMBNAIL_SIZE=320
IMAGE_STRIP_METADATA=true
VOICE_BITRATE=64k
VOICE_MAX_DURATION=300

# === WebSocket ===
WS_HEARTBEAT_INTERVAL=30

# === CORS ===
# Разрешённые домены для запросов к API (через запятую).
# Для разработки: *
# Для продакшна: https://your-domain.com
ALLOWED_ORIGINS=*

# === Admin Panel ===
# Отдельный секрет для admin JWT (scope=admin). Если пусто —
# fallback на JWT_SECRET; в production обязательно отдельный.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
ADMIN_JWT_SECRET=
# Секрет для CSRF double-submit cookie. Generate: token_urlsafe(32)
ADMIN_CSRF_SECRET=
# chat_id Telegram для критичных алертов (через DotSoundBot).
ADMIN_TELEGRAM_ALERT_CHAT_ID=
# TTL подписанной HMAC-ссылки на admin-bundle.js (секунды).
ADMIN_BUNDLE_TTL_SECONDS=3600

# === Observability (опционально) ===
# Если URL пуст — соответствующий компонент не подключается.
PROMETHEUS_URL=
LOKI_URL=
TEMPO_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=

SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Путь к Docker socket для container health check.
# По умолчанию /var/run/docker.sock на Linux.
# На Windows для разработки можно оставить пустым — health-check
# вернёт пустой список без ошибок.
DOCKER_SOCKET_PATH=/var/run/docker.sock

# === Bot Internal API ===
# URL and shared secret for backend <-> bot communication (import features).
BOT_INTERNAL_URL=http://localhost:8081
BOT_INTERNAL_SECRET=change-me-shared-secret

# === Mini App URL ===
# URL Mini App для кнопок в боте.
# Для разработки через ngrok: https://<id>.ngrok-free.app/mini_app/
# Для продакшна: https://your-domain.com/mini_app/
MINI_APP_URL=

# === Outbound HTTP identity ===
# User-Agent для исходящих запросов к публичным источникам
# (Wikipedia/Wikimedia и т. п.). Wikimedia блокирует запросы без
# осмысленного UA -> 403.
#
# Требования Wikimedia (https://meta.wikimedia.org/wiki/User-Agent_policy):
#   1) уникальное имя клиента + версия
#   2) рабочий способ связи (mailto: или https-URL)
# Имя проекта/бренд раскрывать НЕ обязательно. Главное — чтобы
# админ Wikimedia мог с тобой связаться при проблемах, а не
# банить вслепую всю подсеть.
#
# Формат: <name>/<version> (+mailto:contact@your-domain)
# или:    <name>/<version> (+https://your-domain/contact)
#
# Дефолт ниже использует example.invalid — он работает для
# единичных запросов, но при заметном трафике замени на свой
# рабочий email/домен, иначе рискуешь баном без предупреждения.
OUTBOUND_USER_AGENT=metadata-fetcher/1.0 (+mailto:webmaster@example.invalid)
# Опционально: HTTP From-заголовок. Пусто = не отправляем.
OUTBOUND_CONTACT_EMAIL=

# === Tor pool (SoundCloud, Bandcamp — не YouTube) ===
# Нужен только бинарник ``tor[.exe]`` (не обязателен запуск Tor Browser
# с окном; достаточно subdir ``…\Browser\TorBrowser\Tor\``). Порядок:
# PATH, Program Files, ``%USERPROFILE%\Desktop\Tor Browser\...``,
# ``Downloads\…``, OneDrive\Desktop, или явно:
#   TOR_BIN_PATH=C:\Path\to\Tor\tor\tor.exe
# TOR_POOL_ENABLED=false — прямой исходящий HTTP без Tor.
TOR_POOL_ENABLED=true
# Несколько SOCKS: порты base..base+size-1. ``TOR_CONTROL_PORT`` не должен
# попадать в этот диапазон (иначе смещается; дефолт 9151). Занятым 9050
# может быть уже запущенный Tor / Tor Browser — смени ``TOR_SOCKS_BASE_PORT``.
# TOR_POOL_SIZE=10
# TOR_SOCKS_BASE_PORT=9050
# TOR_CONTROL_PORT=9151
# TOR_BIN_PATH=
# true = one HTTPS call to api.ipify.org (no Tor) at start; public IP
# is what guards see if VPN is default-route (not Tor exit).
# TOR_LOG_OUTBOUND_PUBLIC_IP=false

# === Yandex Music post-import lyrics orchestrator ===
# После успешного внешнего импорта backend запускает фоновый
# Taskiq-таск, который по очереди запрашивает лирику для каждого
# импортированного трека. Между треками — случайная пауза в
# диапазоне [MIN, MAX] секунд (rate-limit от капчи). При сигнале
# блока от прокси следующая пауза — COOLDOWN секунд. Значения
# по умолчанию подобраны консервативно; снижай только после того,
# как убедишься, что твой пул прокси не получает капчу.
YANDEX_MUSIC_IMPORT_LYRICS_DELAY_MIN_SECONDS=15
YANDEX_MUSIC_IMPORT_LYRICS_DELAY_MAX_SECONDS=45
YANDEX_MUSIC_IMPORT_LYRICS_COOLDOWN_SECONDS=600

# === Concurrency hardening (Stage 2) ===
# Глобальный cap на одновременные исходящие запросы к
# SoundCloud public API (search/resolve/stream). Без него
# параллельный импорт у нескольких пользователей быстро ест
# квоту SC_CLIENT_ID. Слот удерживается на время одного
# HTTP-запроса; auto-expire через slot_ttl (внутренняя
# константа) защищает от падения воркера с зависшим слотом.
SOUNDCLOUD_GLOBAL_CONCURRENCY=4
# Сколько секунд ждать освобождения слота прежде чем отдать
# 503 Service Unavailable клиенту.
SOUNDCLOUD_SLOT_ACQUIRE_TIMEOUT_SECONDS=30.0
# Per-track Redis lock на время работы generate_lyrics_task.
# Если два воркера попробуют генерировать лирику для одного
# track_id одновременно, второй мгновенно вернёт
# {"status": "skipped", "reason": "already_running"}.
# TTL должен быть >= lyrics_provider_timeout_seconds.
LYRICS_PER_TRACK_LOCK_TTL_SECONDS=300

# === Import job backpressure (Stage 4) ===
# Если уже выполняется N импортов одновременно, новые встают
# в статус "queued" — их подберёт dispatcher loop, как только
# освободится слот. Защищает upstream (SoundCloud + lyrics
# provider) от взрыва нагрузки при массовом импорте.
IMPORT_MAX_CONCURRENT_JOBS=10
# Сколько слотов одновременно может занимать один пользователь.
# Иначе один пользователь может занять всю глобальную очередь.
IMPORT_PER_USER_MAX_CONCURRENT=2
# Период опроса очереди dispatcher-ом (секунды). Чем меньше —
# тем быстрее queued-job становится importing после освобождения
# слота. По умолчанию 30 сек.
IMPORT_QUEUE_DISPATCH_INTERVAL_SECONDS=30

# === Global lyrics orchestrator (Stage 3) ===
# Когда true, после каждого внешнего импорта треки попадают в
# единую Redis-очередь, и один глобальный pacer-loop их
# обрабатывает с общим budget'ом задержек. Это превращает
# "100 параллельных импортов = 100x давления на провайдера" в
# "100 импортов = тот же budget, что и 1 импорт". Если выключить,
# вернётся per-job pacing (legacy).
LYRICS_GLOBAL_ORCHESTRATOR_ENABLED=true
# Имя Redis-списка для очереди. Меняй только если у тебя несколько
# раздельных DotSound-инстансов на одном Redis (что нетипично).
LYRICS_GLOBAL_QUEUE_KEY=lyrics:queue:default
# Cooldown после block-сигнала от прокси-пула (captcha и т.п.).
# Должен быть согласован с YANDEX_MUSIC_IMPORT_LYRICS_COOLDOWN_SECONDS.
LYRICS_GLOBAL_BLOCK_COOLDOWN_SECONDS=600
# После N подряд block-сигналов orchestrator уходит в долгий
# cooldown — даём upstream восстановиться.
LYRICS_GLOBAL_MAX_CONSECUTIVE_BLOCKS=5

# === Backup ===
# GPG passphrase для шифрования дампов БД.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=3
# Удалённый сервер для rsync (пусто = только локальные бэкапы).
BACKUP_REMOTE_HOST=
BACKUP_REMOTE_PATH=/backups/dotsound
BACKUP_REMOTE_SSH_KEY=
