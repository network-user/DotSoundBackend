# DotSound — production reverse proxy.
#
# Required env vars in DotSoundBackend/.env (Caddy reads them via
# docker-compose.prod.yml -> env_file: - .env):
#
#   DOMAIN=your-domain.com
#   ACME_EMAIL=you@your-domain.com
#
# Optional: MinIO presigned-URL subdomain. Required if the Mini App
# fetches audio/cover URLs directly from S3 (default in this codebase).
# After adding an A record for media.your-domain.com pointing here,
# uncomment the second site block AND set in .env:
#
#   MINIO_ENDPOINT=media.your-domain.com
#   MINIO_USE_SSL=true

{
	email {$ACME_EMAIL}
	servers {
		trusted_proxies static private_ranges
	}
}

{$DOMAIN} {
	encode zstd gzip

	# Frontend nginx already routes / -> /mini_app/ and /api/ ->
	# backend:8000 with WebSocket upgrade headers (see
	# frontend/nginx.conf). Caddy only terminates TLS and forwards.
	reverse_proxy frontend:80 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}

	log {
		output stdout
		format console
	}
}

# === Co-hosted sites behind this same Caddy (temporary shared front) =========
# Эти сайты - ОТДЕЛЬНЫЕ проекты (портфолио DotBioSite и DotLearn), временно
# делят этот фронт-Caddy, потому что порты 80/443 хоста уже за ним. Их
# контейнеры живут в этой же сети dotsound; Caddy только терминирует TLS и
# проксирует по имени контейнера. К данным/сервисам DotSound отношения нет.
#
# Домены задаются переменными PORTFOLIO_DOMAIN / DOTLEARN_DOMAIN в .env
# (Caddy читает их через env_file в docker-compose.prod.yml). Плюс: .env НЕ в
# git, поэтому реальные домены не раскрываются в репозитории и переживают
# `git reset --hard` в deploy.sh. Если переменная пуста, блок падает на
# безопасный дефолт *.localhost (внутренний сайт без ACME, DotSound не задет).

# Портфолио (DotBioSite) - контейнер portfolio, статика.
{$PORTFOLIO_DOMAIN:portfolio.localhost} {
	encode zstd gzip
	reverse_proxy portfolio:80 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}
	log {
		output stdout
		format console
	}
}

# DotLearn - контейнер dotlearn-web (свой nginx сам проксирует /api -> api:3000).
{$DOTLEARN_DOMAIN:learn.localhost} {
	encode zstd gzip
	reverse_proxy dotlearn-web:8080 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}
	log {
		output stdout
		format console
	}
}

# === Uncomment when MinIO subdomain is ready ===
#
