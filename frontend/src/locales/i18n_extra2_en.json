      "basisItem1": "Article 1253.1 of the Civil Code — liability of an information intermediary",
      "basisItem2": "Article 1270 of the Civil Code — use of a work",
      "basisItem3": "Article 1301 of the Civil Code — compensation for copyright infringement",
      "basisItem4": "Article 15.7 of Federal Law 149-FZ — out-of-court measures to stop copyright and neighboring rights violations online",
      "contactsTitle": "Contacts",
